// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
model Project {
  id          Int       @id @default(autoincrement())
  title       String
  detail      String    @unique
  deadline    DateTime
  stack       String
  linkgithub  String    @unique

  // Many-to-many relationship with User through Developer model
  developers  Developer[] @relation("ProjectDevelopers")

  reports Report[]
}

model Developer {
  id         Int    @id @default(autoincrement())
  userId     Int
  projectId  Int

  // Define explicit relations to User and Project
  user       User   @relation("ProjectDevelopers", fields: [userId], references: [id])
  project    Project @relation("ProjectDevelopers", fields: [projectId], references: [id])
}

model User {
  id              Int       @id @default(autoincrement())
  nama            String
  usernamegithub  String    @unique
  password        String?
  email           String?   @unique
  role            String
  position        String?

  // Many-to-many relationship with Project through Developer model
  projects        Developer[] @relation("ProjectDevelopers")

  logActivities LogActivity[]

  reports Report[]
}

model LogActivity {
  id        Int      @id @default(autoincrement())
  userId    Int      // This is to reference the user performing the action
  activity  String
  timestamp DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])  // Establish the relation to the User model
}

model Report {
  id            Int      @id @default(autoincrement())
  projectId     Int      // Reference to the associated project
  userId        Int      // Reference to the user who generated the report
  conclusion    String   // Generated summary or conclusion from GroQ
  timestamp     DateTime @default(now())  // Timestamp of when the report was created
  commitRange   String   // A description of the commit range (e.g., "Last 30 commits")

  project       Project  @relation(fields: [projectId], references: [id])  // Relate to Project model
  user          User     @relation(fields: [userId], references: [id])     // Relate to User model
}
