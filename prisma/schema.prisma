generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
  
model Project {
  id                    Int       @id @default(autoincrement())
  title                  String
  detail                String    @unique
  deadline       DateTime
  stack          String
  linkgithub    String @unique

}

model developer {
    id       Int    @id @default(autoincrement())
    userId   Int    
    projectId Int   
}

model user{
    id       Int    @id @default(autoincrement())
    nama     String
    usernamegithub String @unique
    password String
    email    String @unique
    role     String
}

model logActivity {
    id        Int      @id @default(autoincrement())
    userId    Int
    activity  String
    timestamp DateTime @default(now())
}