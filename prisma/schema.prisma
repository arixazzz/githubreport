datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}
enum ProjectVisibility {
  PUBLIC
  PRIVATE
}
model User {
  id              Int      @id @default(autoincrement())
  nama            String
  usernamegithub  String   @unique
  password        String?
  email           String?  @unique
  position        String?
  roles           UserRole[]
  projects        ProjectDeveloper[]
  reports         Report[]
  logActivities   LogActivity[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime @default(now())
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}
model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}
model Project {
  id            Int      @id @default(autoincrement())
  title         String
  detail        String
  stack         String
  deadline      DateTime
  githubOwner   String
  githubRepo    String
  visibility    ProjectVisibility @default(PUBLIC)
  reports       Report[]
  developers    ProjectDeveloper[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([githubOwner, githubRepo])
  @@index([visibility])
}

model ProjectDeveloper {
  projectId Int
  userId    Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
}

model Report {
  id            Int      @id @default(autoincrement())
  projectId     Int
  userId        Int
  commitRange   String
  conclusion    String
  commitDate    DateTime @default(now())
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId, commitDate])
  @@index([userId])
  @@index([projectId])
}

model LogActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  activity  String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

